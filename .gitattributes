# Todo arquivo de texto fica em LF, no repositório e na cópia local, em qualquer máquina:
# a regra vale por cima do core.autocrlf de cada um.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Scripts de shell e git hooks precisam de LF: com CRLF o sh falha.
.githooks/* text eol=lf
*.sh text eol=lf
*.mjs text eol=lf

# Fixtures de extrato ficam byte a byte como o banco exporta: o BOM e o CRLF fazem parte do layout que
# o leitor testa.
tests/**/Fixtures/** -text

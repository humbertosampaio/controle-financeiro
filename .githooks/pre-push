#!/bin/sh
# Na ordem, parando no primeiro que falhar: os checks baratos vêm antes dos caros.
#   1. nada vai direto para a main (tudo entra por PR)
#   2. nome da branch no padrão <tipo>/<issue>-<slug> (ou dependabot/..., para ajustar um PR dele)
#   3. o guardrail e o script de testes afetados continuam íntegros
#   4. build e testes de unidade
#   5. testes de integração dos endpoints afetados pelo push (precisam do Docker)

raiz=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
alterados=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push na main bloqueado: abra um PR a partir de uma branch <tipo>/<issue>-<slug>." >&2
    exit 1
  fi
  # Push que apaga a branch remota: nada a validar.
  [ "$local_sha" = "$zero" ] && continue
  # O nome vem da referência remota: com "git push origin HEAD" a local chega como "HEAD".
  branch=${remote_ref#refs/heads/}
  if ! echo "$branch" | grep -qE '^((feat|fix|chore|docs|refactor|test|perf|build|ci)/[0-9]+-[a-z0-9-]+|dependabot/.+)$'; then
    echo "Branch '$branch' fora do padrão <tipo>/<numero-da-issue>-<slug> (ex.: feat/7-importar-ofx-c6)." >&2
    exit 1
  fi
  # Branch nova no remoto: compara com a main; senão, com o que o remoto já tem.
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    alterados="$alterados
$(git diff --name-only "$base" "$local_sha")"
  else
    # Sem base para comparar (sem origin/main local, por exemplo): na dúvida, roda tudo.
    sem_base=1
  fi
done

# Usado pelos testes do guardrail: valida só as referências, sem rodar os testes (evita recursão).
[ "$1" = "--somente-refs" ] && exit 0

node "$raiz/scripts/harness/guardrail.test.mjs" >/dev/null 2>&1 || {
  echo "Os testes do guardrail falharam: rode node scripts/harness/guardrail.test.mjs" >&2
  exit 1
}

node "$raiz/scripts/harness/testes-afetados.test.mjs" >/dev/null 2>&1 || {
  echo "Os testes do script de testes afetados falharam: rode node scripts/harness/testes-afetados.test.mjs" >&2
  exit 1
}

dotnet build "$raiz/ControleFinanceiro.slnx" --nologo -v q >/dev/null 2>&1 || {
  echo "O build falhou: rode dotnet build ControleFinanceiro.slnx" >&2
  exit 1
}

dotnet test "$raiz/ControleFinanceiro.slnx" --no-build --nologo -v q \
  --filter "FullyQualifiedName!~ControleFinanceiro.WebApi.Tests" >/dev/null 2>&1 || {
  echo "Os testes de unidade falharam: rode dotnet test ControleFinanceiro.slnx --filter \"FullyQualifiedName!~ControleFinanceiro.WebApi.Tests\"" >&2
  exit 1
}

if [ -n "$sem_base" ]; then
  filtro=todos
else
  filtro=$(printf '%s\n' "$alterados" | node "$raiz/scripts/harness/testes-afetados.mjs")
fi
[ -z "$filtro" ] && exit 0

docker info >/dev/null 2>&1 || {
  echo "Este push altera código coberto por testes de integração, e eles precisam do Docker: inicie o Docker e tente de novo." >&2
  exit 1
}

projeto="$raiz/tests/ControleFinanceiro.WebApi.Tests"
if [ "$filtro" = "todos" ]; then
  dotnet test "$projeto" --no-build --nologo -v q >/dev/null 2>&1
else
  dotnet test "$projeto" --no-build --nologo -v q --filter "$filtro" >/dev/null 2>&1
fi || {
  if [ "$filtro" = "todos" ]; then
    echo "Os testes de integração falharam: rode dotnet test tests/ControleFinanceiro.WebApi.Tests" >&2
  else
    echo "Os testes de integração afetados falharam: rode dotnet test tests/ControleFinanceiro.WebApi.Tests --filter \"$filtro\"" >&2
  fi
  exit 1
}

exit 0

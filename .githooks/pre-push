#!/bin/sh
# Na ordem, parando no primeiro que falhar: os checks baratos vêm antes dos caros.
#   1. nada vai direto para a main (tudo entra por PR)
#   2. nome da branch no padrão <tipo>/<issue>-<slug> (ou dependabot/..., para ajustar um PR dele)
#   3. o guardrail e o script de testes afetados continuam íntegros
#   4. build e testes de unidade
#   5. testes de integração dos endpoints afetados pelo push (precisam do Docker)

raiz=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
alterados=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push na main bloqueado: abra um PR a partir de uma branch <tipo>/<issue>-<slug>." >&2
    exit 1
  fi
  # Push que apaga a branch remota: nada a validar.
  [ "$local_sha" = "$zero" ] && continue
  # O nome vem da referência remota: com "git push origin HEAD" a local chega como "HEAD".
  branch=${remote_ref#refs/heads/}
  if ! echo "$branch" | grep -qE '^((feat|fix|chore|docs|refactor|test|perf|build|ci)/[0-9]+-[a-z0-9-]+|dependabot/.+)$'; then
    echo "Branch '$branch' fora do padrão <tipo>/<numero-da-issue>-<slug> (ex.: feat/7-importar-ofx-c6)." >&2
    exit 1
  fi
  # Branch nova no remoto: compara com a main; senão, com o que o remoto já tem.
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    alterados="$alterados
$(git diff --name-only "$base" "$local_sha")"
  else
    # Sem base para comparar (sem origin/main local, por exemplo): na dúvida, roda tudo.
    sem_base=1
  fi
done

# Usado pelos testes do guardrail: valida só as referências, sem rodar os testes (evita recursão).
[ "$1" = "--somente-refs" ] && exit 0

# A saída de cada etapa vai para um log temporário, que some no sucesso. Na falha, o hook mostra
# os testes que falharam com a mensagem (ou o fim do log) e onde está o log, para que uma falha
# intermitente deixe rastro.
log=$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")
trap 'rm -f "$log"' EXIT

falhou() {
  echo "$1" >&2
  trecho=$(awk '/^  Failed /{p=1} /^  Stack Trace:/{p=0} p' "$log")
  [ -n "$trecho" ] || trecho=$(tail -n 30 "$log")
  printf '%s\n' "$trecho" >&2
  caminho=$log
  command -v cygpath >/dev/null 2>&1 && caminho=$(cygpath -w "$log")
  echo "Log completo: $caminho" >&2
  trap - EXIT
  exit 1
}

node "$raiz/scripts/harness/guardrail.test.mjs" >"$log" 2>&1 ||
  falhou "Os testes do guardrail falharam: rode node scripts/harness/guardrail.test.mjs"

node "$raiz/scripts/harness/testes-afetados.test.mjs" >"$log" 2>&1 ||
  falhou "Os testes do script de testes afetados falharam: rode node scripts/harness/testes-afetados.test.mjs"

dotnet build "$raiz/ControleFinanceiro.slnx" --nologo -v q >"$log" 2>&1 ||
  falhou "O build falhou: rode dotnet build ControleFinanceiro.slnx"

# O logger em minimal imprime cada teste que falhou com a mensagem; o -v q sozinho só daria o nome.
dotnet test "$raiz/ControleFinanceiro.slnx" --no-build --nologo -v q --logger "console;verbosity=minimal" \
  --filter "FullyQualifiedName!~ControleFinanceiro.WebApi.Tests" >"$log" 2>&1 ||
  falhou "Os testes de unidade falharam: rode dotnet test ControleFinanceiro.slnx --filter \"FullyQualifiedName!~ControleFinanceiro.WebApi.Tests\""

if [ -n "$sem_base" ]; then
  filtro=todos
else
  filtro=$(printf '%s\n' "$alterados" | node "$raiz/scripts/harness/testes-afetados.mjs")
fi
[ -z "$filtro" ] && exit 0

docker info >/dev/null 2>&1 || {
  echo "Este push altera código coberto por testes de integração, e eles precisam do Docker: inicie o Docker e tente de novo." >&2
  exit 1
}

projeto="$raiz/tests/ControleFinanceiro.WebApi.Tests"
if [ "$filtro" = "todos" ]; then
  dotnet test "$projeto" --no-build --nologo -v q --logger "console;verbosity=minimal" >"$log" 2>&1 ||
    falhou "Os testes de integração falharam: rode dotnet test tests/ControleFinanceiro.WebApi.Tests"
else
  dotnet test "$projeto" --no-build --nologo -v q --logger "console;verbosity=minimal" --filter "$filtro" >"$log" 2>&1 ||
    falhou "Os testes de integração afetados falharam: rode dotnet test tests/ControleFinanceiro.WebApi.Tests --filter \"$filtro\""
fi

exit 0

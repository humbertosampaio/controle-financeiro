#!/bin/sh
# Na ordem, parando no primeiro que falhar: os checks baratos vêm antes dos caros.
#   1. nada vai direto para a main (tudo entra por PR)
#   2. nome da branch no padrão <tipo>/<issue>-<slug>
#   3. o guardrail continua íntegro
#   4. build e testes

raiz=$(git rev-parse --show-toplevel)

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push na main bloqueado: abra um PR a partir de uma branch <tipo>/<issue>-<slug>." >&2
    exit 1
  fi
  # O nome vem da referência remota: com "git push origin HEAD" a local chega como "HEAD".
  branch=${remote_ref#refs/heads/}
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ] && \
     ! echo "$branch" | grep -qE '^(feat|fix|chore|docs|refactor|test|perf|build|ci)/[0-9]+-[a-z0-9-]+$'; then
    echo "Branch '$branch' fora do padrão <tipo>/<numero-da-issue>-<slug> (ex.: feat/7-importar-ofx-c6)." >&2
    exit 1
  fi
done

# Usado pelos testes do guardrail: valida só as referências, sem rodar os testes (evita recursão).
[ "$1" = "--somente-refs" ] && exit 0

node "$raiz/scripts/harness/guardrail.test.mjs" >/dev/null 2>&1 || {
  echo "Os testes do guardrail falharam: rode node scripts/harness/guardrail.test.mjs" >&2
  exit 1
}

dotnet test "$raiz/ControleFinanceiro.slnx" --nologo -v q >/dev/null 2>&1 || {
  echo "Build ou testes falharam: rode dotnet test ControleFinanceiro.slnx" >&2
  exit 1
}

exit 0

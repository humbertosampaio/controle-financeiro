    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="CSharpFunctionalExtensions.FluentAssertions" Version="3.6.0" />
    <PackageVersion Include="CsvHelper" Version="34.0.0" />

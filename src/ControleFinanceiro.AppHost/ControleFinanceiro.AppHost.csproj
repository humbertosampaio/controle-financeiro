<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>158ce70b-07af-4594-be28-125a3ed8240c</UserSecretsId>
    <!-- Orquestrador e dashboard vêm da Aspire CLI (dotnet tool install -g Aspire.Cli). Sem a CLI
         no PATH, como no CI, o build usa a versão pareada com o SDK via dnx. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Corrige GHSA-qhrr-8q5h-9q3h: o StreamJsonRpc do Aspire ainda traz o MessagePack 2.5.302 -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControleFinanceiro.WebApi\ControleFinanceiro.WebApi.csproj" />
  </ItemGroup>

</Project>

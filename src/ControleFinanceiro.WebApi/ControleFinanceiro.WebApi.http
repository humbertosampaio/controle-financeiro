@ControleFinanceiro.WebApi_HostAddress = https://localhost:7029

POST {{ControleFinanceiro.WebApi_HostAddress}}/api/usuarios
Accept: application/json
Content-Type: application/json

{
  "nome": null,
  "rendaBruta": 1000,
  "descontosSalariais": [
    {
      "descricao": "INSS",
      "valor": 0.1
    },
    {
      "descricao": "Contabilidade",
      "valor": 1
    }
  ]
}

###

# Troque o id pelo devolvido no cadastro acima.
POST {{ControleFinanceiro.WebApi_HostAddress}}/api/usuarios/00000000-0000-0000-0000-000000000000/cartoes
Accept: application/json
Content-Type: application/json

{
  "banco": "336",
  "sufixo": "1234",
  "diaVencimento": 10,
  "diaFechamento": 3
}

###

# Troque os ids pelos devolvidos nos cadastros acima.
PUT {{ControleFinanceiro.WebApi_HostAddress}}/api/usuarios/00000000-0000-0000-0000-000000000000/cartoes/00000000-0000-0000-0000-000000000000/ciclo-fatura
Accept: application/json
Content-Type: application/json

{
  "diaVencimento": 15,
  "diaFechamento": 8
}

###

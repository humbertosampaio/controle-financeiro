<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- A referência ao executável copia a DLL, o .deps.json e o .runtimeconfig.json do servidor para o bin do teste. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ControleFinanceiro.Mcp\ControleFinanceiro.Mcp.csproj" />
    <ProjectReference Include="..\ControleFinanceiro.Tests.Shared\ControleFinanceiro.Tests.Shared.csproj" />
  </ItemGroup>

  <!-- A imagem do Postgres é a mesma do AppHost. -->
  <ItemGroup>
    <Compile Include="..\..\src\ControleFinanceiro.AppHost\Resources\PostgresImagem.cs" Link="Infraestrutura\PostgresImagem.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
